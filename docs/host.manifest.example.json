{
  "host_name": "exemple-hote",
  "host_version": "0.1.0",
  "capabilities": ["clavier", "souris", "vision", "attente", "infos-systeme"],
  "tools": [
    {
      "name": "cliquer",
      "kind": "action",
      "effects": "uncertain",
      "description": "Clique à un endroit de l'écran. Renvoie true si le clic est parti.",
      "parameters": {
        "type": "object",
        "properties": {
          "x": { "type": "integer", "description": "Position horizontale en pixels." },
          "y": { "type": "integer", "description": "Position verticale en pixels." }
        },
        "required": ["x", "y"]
      }
    },
    {
      "name": "clic_element",
      "kind": "action",
      "description": "Clique une cible déjà perçue. Le paramètre target reçoit un nom local fourni par ManAgent.",
      "parameters": {
        "type": "object",
        "properties": {
          "target": { "type": "string", "description": "Nom local de la cible à cliquer." }
        },
        "required": ["target"]
      },
      "target_contract": {
        "version": 1,
        "consumes": [
          { "param": "target", "scope": "ui_element" }
        ]
      }
    },
    {
      "name": "taper_texte",
      "kind": "action",
      "description": "Tape du texte au clavier. Renvoie true si envoyé.",
      "parameters": {
        "type": "object",
        "properties": {
          "texte": { "type": "string", "description": "Le texte à taper." }
        },
        "required": ["texte"]
      }
    },
    {
      "name": "lire_ecran",
      "kind": "perception",
      "description": "Décrit les éléments visibles à l'écran et renvoie data.targets. Appelé uniquement via perceive_understand, jamais en direct.",
      "parameters": {
        "type": "object",
        "properties": {
          "question": { "type": "string", "description": "Que chercher (ex: où est le bouton OK ?)." },
          "target": { "type": "string", "description": "Zone/cible à inspecter (nom local fourni par ManAgent)." }
        },
        "required": ["question"]
      },
      "target_contract": {
        "version": 1,
        "consumes": [
          { "param": "target", "scope": "ui_element", "required": false }
        ],
        "produces": [
          {
            "path": "data.targets",
            "mode": "candidates",
            "scope": "ui_element",
            "reliability": "low",
            "fields": {
              "ref": "id",
              "description": "label",
              "correlation_id": "corr",
              "generation": "gen",
              "attributes": {
                "role": "role",
                "rect": "bounds",
                "cells": "cells"
              }
            }
          }
        ],
        "disclosure": {
          "version": 1,
          "reliability": "medium",
          "evidence": ["metadata", "rect"],
          "zoom_probe": "zoomer",
          "views": [
            {
              "name": "grid",
              "path": "data.grid",
              "description": "Grille de cellules (vue nommee par l'hote)."
            }
          ],
          "anchors": [
            {
              "kind": "cell",
              "param": "cell",
              "description": "Cellule brute de la grille.",
              "reliability": "high"
            }
          ],
          "probes": [
            {
              "id": "elargir",
              "kind": "widen",
              "description": "Relit l'écran avec la question comme indice, sans changer de cible.",
              "tool": "lire_ecran",
              "args": {},
              "hint_param": "question",
              "produces": ["candidates", "grid"]
            },
            {
              "id": "zoomer",
              "kind": "zoom",
              "description": "Inspecte une cible locale déjà vue et renvoie ses cibles internes.",
              "tool": "lire_ecran",
              "args": {},
              "subject": { "kind": "local", "param": "target" },
              "produces": ["candidates", "grid"],
              "preserves_references": true
            }
          ]
        }
      }
    },
    {
      "name": "capturer_image",
      "kind": "perception",
      "description": "Capture l'écran. Appelé uniquement via perceive_understand, jamais en direct.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "returns": [
        {
          "field": "image_base64",
          "asset": "image/jpeg",
          "description": "Photo d'écran encodée base64."
        },
        {
          "field": "cadre",
          "asset": "application/json",
          "description": "Structure détectée."
        }
      ]
    },
    {
      "name": "attendre",
      "kind": "action",
      "description": "Attend un moment. Renvoie true quand c'est fini.",
      "parameters": {
        "type": "object",
        "properties": {
          "duree_ms": { "type": "integer", "description": "Durée en millisecondes." }
        },
        "required": []
      }
    },
    {
      "name": "info_systeme",
      "kind": "perception",
      "description": "Donne une info sur la machine. Appelé uniquement via perceive_understand, jamais en direct.",
      "parameters": {
        "type": "object",
        "properties": {
          "sujet": { "type": "string", "description": "os, memoire ou processus." }
        },
        "required": ["sujet"]
      }
    }
  ],
  "environment": {
    "os": "windows-11",
    "ecran": "1920x1080",
    "langue": "fr-FR"
  },
  "metadata": {
    "managent_min_version": "0.1.0"
  },
  "embeddings": {
    "mode": "lite"
  }
}
