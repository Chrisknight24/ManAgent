{
  "host_name": "exemple-hote",
  "host_version": "0.1.0",
  "capabilities": ["clavier", "souris", "vision", "attente", "infos-systeme"],
  "tools": [
    {
      "name": "cliquer",
      "kind": "action",
      "effects": "uncertain",
      "description": "Clique à un endroit de l'écran. Renvoie true si le clic est parti.",
      "parameters": {
        "type": "object",
        "properties": {
          "x": { "type": "integer", "description": "Position horizontale en pixels." },
          "y": { "type": "integer", "description": "Position verticale en pixels." }
        },
        "required": ["x", "y"]
      }
    },
    {
      "name": "clic_element",
      "kind": "action",
      "description": "Clique une cible déjà perçue. Le paramètre target reçoit un nom local fourni par ManAgent.",
      "parameters": {
        "type": "object",
        "properties": {
          "target": { "type": "string", "description": "Nom local de la cible à cliquer." }
        },
        "required": ["target"]
      },
      "target_contract": {
        "version": 1,
        "consumes": [
          { "param": "target", "scope": "ui_element" }
        ]
      }
    },
    {
      "name": "taper_texte",
      "kind": "action",
      "description": "Tape du texte au clavier. Renvoie true si envoyé.",
      "parameters": {
        "type": "object",
        "properties": {
          "texte": { "type": "string", "description": "Le texte à taper." }
        },
        "required": ["texte"]
      }
    },
    {
      "name": "lire_ecran",
      "kind": "perception",
      "description": "Décrit les éléments visibles à l'écran et renvoie data.targets. Appelé uniquement via perceive_understand, jamais en direct.",
      "parameters": {
        "type": "object",
        "properties": {
          "question": { "type": "string", "description": "Que chercher (ex: où est le bouton OK ?)." }
        },
        "required": ["question"]
      },
      "target_contract": {
        "version": 1,
        "produces": [
          {
            "path": "data.targets",
            "mode": "candidates",
            "scope": "ui_element",
            "fields": {
              "ref": "id",
              "description": "label",
              "correlation_id": "corr",
              "generation": "gen"
            }
          }
        ]
      }
    },
    {
      "name": "capturer_image",
      "kind": "perception",
      "description": "Capture l'écran. Appelé uniquement via perceive_understand, jamais en direct.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "returns": [
        {
          "field": "image_base64",
          "asset": "image/jpeg",
          "description": "Photo d'écran encodée base64."
        },
        {
          "field": "cadre",
          "asset": "application/json",
          "description": "Structure détectée."
        }
      ]
    },
    {
      "name": "attendre",
      "kind": "action",
      "description": "Attend un moment. Renvoie true quand c'est fini.",
      "parameters": {
        "type": "object",
        "properties": {
          "duree_ms": { "type": "integer", "description": "Durée en millisecondes." }
        },
        "required": []
      }
    },
    {
      "name": "info_systeme",
      "kind": "perception",
      "description": "Donne une info sur la machine. Appelé uniquement via perceive_understand, jamais en direct.",
      "parameters": {
        "type": "object",
        "properties": {
          "sujet": { "type": "string", "description": "os, memoire ou processus." }
        },
        "required": ["sujet"]
      }
    }
  ],
  "environment": {
    "os": "windows-11",
    "ecran": "1920x1080",
    "langue": "fr-FR"
  },
  "metadata": {
    "managent_min_version": "0.1.0"
  },
  "embeddings": {
    "mode": "lite"
  }
}
