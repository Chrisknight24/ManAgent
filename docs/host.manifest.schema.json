{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HostManifest",
  "description": "Contrat de declaration d'un hote agnostique pour ManAgent. Ref: core/host_manifest.py",
  "type": "object",
  "required": ["host_name", "host_version"],
  "properties": {
    "host_name": { "type": "string", "minLength": 1 },
    "host_version": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["perception", "action", "utility"] },
          "description": { "type": "string" },
          "parameters": { "type": "object" },
          "returns": {
            "type": "array",
            "description": "Typed output payloads (ManAgent vocabulary: MIME types). Optional; undeclared = text.",
            "items": {
              "type": "object",
              "required": ["field", "asset"],
              "properties": {
                "field": { "type": "string", "description": "Dotted path inside result data." },
                "asset": { "type": "string", "description": "Imposed MIME type (image/jpeg, application/json...)." },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "environment": { "type": "object" },
    "metadata": { "type": "object" },
    "embeddings": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["lite", "local", "remote"] },
        "model": { "type": "string" },
        "api_key": { "type": "string" },
        "base_url": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
