{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HostManifest",
  "description": "Contrat de declaration d'un hote agnostique pour ManAgent. Ref: core/host_manifest.py",
  "type": "object",
  "required": ["host_name", "host_version"],
  "properties": {
    "host_name": { "type": "string", "minLength": 1 },
    "host_version": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["perception", "action", "utility"] },
          "effects": { "type": "string", "enum": ["deterministic", "uncertain"], "description": "Optional. Undeclared action = uncertain (cautious). See docs/ALIGNMENT.md." },
          "effects_timeout_ms": { "type": "integer", "minimum": 1, "description": "Optional wait after action, milliseconds. Absent = no wait." },
          "max_wait_ms": { "type": "integer", "minimum": 1, "description": "Optional per-tool active-wait ceiling (changing_effects). Absent = host default." },
          "description": { "type": "string" },
          "parameters": { "type": "object" },
          "target_contract": {
            "type": "object",
            "description": "Optional opaque-target contract (version 1). Invalid contract = tool stays usable but target-inert. Ref: docs/HOST_CONTRACT.md section 3i.",
            "required": ["version"],
            "properties": {
              "version": { "type": "integer", "const": 1 },
              "consumes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["param"],
                  "properties": {
                    "param": {
                      "type": "string",
                      "description": "Top-level tool parameter. Reserved: source, source_data, sources. Must not declare an enum."
                    },
                    "scope": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
                    },
                    "required": { "type": "boolean", "default": true },
                    "raw": { "type": "string", "enum": ["deny", "allow"], "default": "deny" }
                  },
                  "additionalProperties": true
                }
              },
              "produces": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "mode", "fields"],
                  "description": "Use scope XOR fields.scope. fields.ref is mandatory.",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
                      "description": "Dotted path relative to the full tool result (e.g. data.targets)."
                    },
                    "mode": { "type": "string", "enum": ["single", "candidates"] },
                    "scope": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
                    },
                    "fields": {
                      "type": "object",
                      "required": ["ref"],
                      "properties": {
                        "ref": { "type": "string" },
                        "description": { "type": "string" },
                        "scope": { "type": "string" },
                        "correlation_id": { "type": "string" },
                        "generation": { "type": "string" },
                        "attributes": {
                          "type": "object",
                          "description": "Free selector-visible fields: {public_name: read.path}. Never the raw reference.",
                          "additionalProperties": { "type": "string" }
                        }
                      },
                      "additionalProperties": true
                    },
                    "usable_as": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Consumable scopes; default [scope]. Not transitive."
                    }
                  },
                  "additionalProperties": true
                }
              },
              "disclosure": {
                "type": "object",
                "description": "Optional inspection recipe (version 1). The host declares named views, raw anchor kinds and allowed probes; the brain never invents a tool, a target type or an argument.",
                "required": ["version"],
                "properties": {
                  "version": { "type": "integer", "const": 1 },
                  "views": {
                    "type": ["object", "array"],
                    "description": "Named views the selector may read. Object form: {name: dotted.path}; array form: [{name, path, description}].",
                    "additionalProperties": true
                  },
                  "anchors": {
                    "type": ["object", "array"],
                    "description": "Raw anchor kinds the host accepts. Object form: {kind: consumer_param}; array form: [{kind, param, description}]. `kind` is HOST vocabulary (cell, file, key, joint...).",
                    "additionalProperties": true
                  },
                  "probes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "kind"],
                      "properties": {
                        "id": { "type": "string", "description": "Stable probe identifier used by discovery_request.technical_goals." },
                        "kind": { "type": "string", "minLength": 1, "description": "Free HOST vocabulary (widen, zoom, read_file, read_sensor...). The brain assigns no meaning to it." },
                        "description": { "type": "string" },
                        "tool": { "type": "string", "description": "Declared host tool to run. Omitted = probe is not executable." },
                        "args": { "type": "object", "description": "Fixed arguments sent verbatim (LLM cannot override them)." },
                        "hint_param": { "type": "string", "description": "Parameter that receives the natural-language question." },
                        "subject": {
                          "type": "object",
                          "description": "Optional subject injected by the brain. kind='local' means a registry key; any other kind must be declared in anchors.",
                          "required": ["kind", "param"],
                          "properties": {
                            "kind": { "type": "string", "minLength": 1 },
                            "param": { "type": "string" },
                            "scheme": { "type": "string" }
                          },
                          "additionalProperties": false
                        },
                        "produces": {
                          "type": "array",
                          "items": { "type": "string", "description": "What the probe refreshes: candidates, a named view, media..." }
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "returns": {
            "type": "array",
            "description": "Typed output payloads (ManAgent vocabulary: MIME types). Optional; undeclared = text.",
            "items": {
              "type": "object",
              "required": ["field", "asset"],
              "properties": {
                "field": { "type": "string", "description": "Dotted path inside result data." },
                "asset": { "type": "string", "description": "Imposed MIME type (image/jpeg, application/json...)." },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "environment": { "type": "object" },
    "metadata": { "type": "object" },
    "embeddings": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["lite", "local", "remote"] },
        "model": { "type": "string" },
        "api_key": { "type": "string" },
        "base_url": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
